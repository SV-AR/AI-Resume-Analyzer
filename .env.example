# Copy to .env (cp .env.example .env) and edit. Never commit .env.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=resume_analyzer
# Local (no Docker) development talks to localhost. docker-compose overrides this with "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth --------------------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
# Load spaCy + the transformer at startup instead of on first request.
PRELOAD_MODELS=false
# Optional: JSON file that extends the skill dictionary (see README).
# CUSTOM_SKILLS_PATH=sample_data/custom_skills.example.json

# --- Frontend (build time) ---------------------------------------------------
VITE_API_URL=http://localhost:8000/api
